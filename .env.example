# Copy this file to .env.local for `vercel dev`, and add the same variable
# in your Vercel project's Environment Variables settings for production.
# Never commit your actual .env.local / .env - they're already gitignored.

# Optional. Without this, the EV charging toggle is wired up but always
# returns zero carparks. Get a free key by registering at
# https://datamall.lta.gov.sg/ (accept the Singapore Open Data Licence).
LTA_ACCOUNT_KEY=
